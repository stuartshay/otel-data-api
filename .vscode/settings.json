{
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "."
    ],
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".mypy_cache": true,
        ".ruff_cache": true,
        ".pytest_cache": true
    },
    "chat.tools.terminal.autoApprove": {
        "git": true,
        "gh": true,
        "make": true,
        "pre-commit": true,
        "python": true,
        "python3": true,
        "pip": true,
        "pytest": true,
        "ruff": true,
        "mypy": true,
        "uvicorn": true,
        "docker": true,
        "kubectl": true,
        "argocd": true,
        "curl": true,
        "wget": true,
        "jq": true,
        "ls": true,
        "cat": true,
        "head": true,
        "tail": true,
        "grep": true,
        "find": true,
        "echo": true,
        "which": true,
        "rm": false,
        "sudo": false,
        "/git\\s+push.*--force(?!-with-lease)/": false,
        "/git\\s+reset\\s+--hard/": false
    }
}
